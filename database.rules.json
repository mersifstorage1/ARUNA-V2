{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "bukutamu": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['nama', 'hp', 'instansi', 'skor', 'kode', 'ts'])",
        "nama": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "hp": {
          ".validate": "newData.isString() && newData.val().matches(/^08[0-9]{8,12}$/)"
        },
        "instansi": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "skor": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "kode": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{5}$/)"
        },
        "ts": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "halloffame": {
      ".read": true,
      ".indexOn": [
        "skor"
      ],
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['nama', 'instansi', 'skor', 'ts'])",
        "nama": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "instansi": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "skor": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "ts": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "logbook": {
      ".read": true,
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['nama', 'instansi', 'hp', 'foto', 'ts'])",
        "nama": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "instansi": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "hp": {
          ".validate": "newData.isString() && newData.val().matches(/^08[0-9]{2}\\*{4}[0-9]{3}$/)"
        },
        "foto": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 400000"
        },
        "ts": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "logbookPrivat": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['nama', 'hp', 'instansi', 'ts'])",
        "nama": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "instansi": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "hp": {
          ".validate": "newData.isString() && newData.val().matches(/^08[0-9]{8,12}$/)"
        },
        "ts": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
